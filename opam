opam-version: "2.0"
name: "rocq-iris-transfinite"
maintainer: "Dongjae Lee <dongjael@mit.edu>"
authors: "The Iris Team"
license: "BSD"
homepage: "https://github.com/dongjaelee1/transfinite-iris"
bug-reports: "https://github.com/dongjaelee1/transfinite-iris/issues"
dev-repo: "git+https://github.com/dongjaelee1/transfinite-iris.git"

synopsis: "Transfinite Iris on upstream Iris: ordinal step-indexed uPred/iProp, base-logic libraries and program logic"

depends: [
  "rocq-core" { (>= "9.0" & < "9.4~") | (= "dev") }
  "rocq-stdpp" { (= "dev.2026-09-17.0.d510b616") | (= "dev") }
  # The same upstream Iris commit xv6iris builds with (opam/xv6rocq.export: rocq-iris
  # dev.2026-09-24.0.8e490959), plus the four commits of Iris branch robbert/transfinite that
  # change the BI laws for transfinite step-indexing ("Change laws of BI to support Transfinite
  # and make siProp Transfinite", "Change definition of Timeless", "Rename later_false_impl",
  # "Add smart constructor bi_later_mixin_sidx_finite") and one local fix (monPred_lc_mixin).
  # No released rocq-iris contains these yet; until robbert/transfinite is merged upstream the
  # package is the patched branch, versioned <upstream version>+transfinite.<commit>.
  "rocq-iris" { (= "dev.2026-09-24.0.8e490959+transfinite.ad972179") | (= "dev") }
]

build: [make "-j%{jobs}%"]
install: [make "install"]
